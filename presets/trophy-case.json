{
  "$schema": "https://raw.githubusercontent.com/GiuseppeBellamacina/profile-forge/main/config.schema.json",
  "themes": { "dark": "outrun", "light": "dayfox" },
  "card": { "background": { "pattern": "grid" } },
  "layout": ["header", "trophies", "heatmap"],
  "header": { "facts": ["stars", "followers", "longestStreak"], "rankIcon": "percentile", "frame": "laurel", "rankStyle": "shield" },
  "trophies": {
    "columns": 5,
    "marginW": 16,
    "marginH": 16,
    "title": "Hall of fame",
    "sort": "rank",
    "highlight": ["Stars", "Commits"]
  },
  "heatmap": { "weeks": 26, "legend": false, "cell": "triangle" }
}
