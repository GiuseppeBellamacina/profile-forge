{
  "$schema": "https://raw.githubusercontent.com/GiuseppeBellamacina/profile-forge/main/config.schema.json",
  "themes": { "dark": "everforest-dark", "light": "everforest-light" },
  "layout": ["header", ["stats", "languages"], "trophies", "rhythm", "heatmap"],
  "header": { "facts": ["stars", "followers", "contributionsThisYear", "topLanguage"], "frame": "stars", "rankStyle": "hexagon" },
  "stats": {
    "show": ["prsMerged", "prsMergedPercentage", "discussionsStarted", "discussionsAnswered"],
    "hide": ["commits"],
    "lineHeight": 28
  },
  "languages": { "layout": "donut-vertical", "sizeWeight": 0.5, "countWeight": 1, "hide": ["HTML", "CSS", "Shell"] },
  "trophies": {
    "titles": ["Stars", "Followers", "PullRequest", "Reviews", "Repositories"],
    "columns": 5,
    "sort": "rank"
  },
  "rhythm": { "show": ["months"] },
  "heatmap": { "cell": "snowflake" }
}
