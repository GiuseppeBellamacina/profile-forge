{
  "$schema": "https://raw.githubusercontent.com/GiuseppeBellamacina/profile-forge/main/config.schema.json",
  "themes": { "dark": "everforest-dark", "light": "everforest-light" },
  "layout": ["header", ["stats", "languages"], "trophies", "heatmap"],
  "header": { "facts": ["stars", "followers", "contributionsThisYear", "topLanguage"] },
  "stats": { "show": ["prsMerged", "prsMergedPercentage", "discussionsStarted", "discussionsAnswered"], "hide": ["commits"], "lineHeight": 28 },
  "languages": { "layout": "donut-vertical", "sizeWeight": 0.5, "countWeight": 1, "hide": ["HTML", "CSS", "Shell"] },
  "trophies": { "titles": ["Stars", "Followers", "PullRequest", "Reviews", "Repositories"], "extra": ["Reviews"], "columns": 5 }
}
