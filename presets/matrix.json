{
  "$schema": "https://raw.githubusercontent.com/GiuseppeBellamacina/profile-forge/main/config.schema.json",
  "themes": { "dark": "matrix", "light": "matrix-day" },
  "customThemes": {
    "matrix-day": {
      "base": "light",
      "bg_color": "f1fbf3", "panel_color": "e0f5e5", "border_color": "8fd3a1",
      "text_color": "062b12", "muted_color": "3f7a52",
      "icon_color": "00a02c", "ring_color": "007a22", "fire_color": "6b8f00"
    }
  },
  "card": { "radius": 4, "background": { "pattern": "grid", "glow": true } },
  "layout": ["header", ["stats", "streak"], "languages", "trophies", "heatmap"],
  "header": { "frame": "glitch", "facts": ["contributionsThisYear", "bestDay", "busiestWeekday", "longestStreak"], "rankIcon": "level" },
  "stats": { "title": "> stats", "numberFormat": "short", "lineHeight": 28 },
  "streak": { "title": "> streak", "dateFormat": "Y-m-d" },
  "languages": { "layout": "compact", "count": 6 },
  "trophies": { "title": "> trophies", "columns": 8, "rows": 2, "marginW": 10, "marginH": 10 },
  "heatmap": { "weekStart": "mon", "cell": "square" }
}
